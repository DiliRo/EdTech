{
  "name": "edtech",
  "version": "0.1.0",
  "description": "API de edTech: plataforma de apoyo pedagógico para docentes de primaria de Guatemala",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon",
    "test": "node --import ./tests/setup-env.js --test \"tests/**/*.test.js\"",
    "test:unit": "node --import ./tests/setup-env.js --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --import ./tests/setup-env.js --test \"tests/integration/**/*.test.js\"",
    "catalog:import": "node scripts/importCatalog.js",
    "catalog:seed-sample": "node scripts/importCatalog.js data/catalog/sample.catalog.json",
    "methodologies:seed": "node scripts/seedMethodologies.js",
    "ai:check": "node scripts/checkAI.js"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "edtech",
    "guatemala",
    "educacion",
    "cnb"
  ],
  "author": "Dilan André Rodas Aldana",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.10",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2"
  }
}
