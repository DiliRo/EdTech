# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# Entorno: development | production | test
NODE_ENV=development

# Puerto del servidor HTTP
PORT=3000

# Conexión a MongoDB (obligatoria)
# Local:  mongodb://127.0.0.1:27017/edtech
# Atlas:  mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/edtech
MONGODB_URI=mongodb://127.0.0.1:27017/edtech

# Orígenes permitidos por CORS, separados por coma (frontend de Vite por defecto)
CORS_ORIGIN=http://localhost:5173

# ── Autenticación ────────────────────────────────────────────
# Secreto para firmar los JWT (obligatorio, mínimo 32 caracteres).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Duración de la sesión (formato de jsonwebtoken: 8h, 1d, 30m...)
JWT_EXPIRES_IN=8h

# Costo de bcrypt (entre 10 y 12 es razonable; más alto = más lento)
BCRYPT_SALT_ROUNDS=12

# ── Protección contra intentos repetidos ─────────────────────
# Intentos fallidos de login permitidos por IP + correo dentro de la ventana
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
# Registros permitidos por IP en una hora
REGISTER_MAX_PER_HOUR=10

# ── Seguimiento académico ────────────────────────────────────
# Porcentaje de logro bajo el cual un resultado se señala para acompañamiento (0-100).
# Es un indicador de apoyo al docente, no un diagnóstico.
PERFORMANCE_THRESHOLD=60
