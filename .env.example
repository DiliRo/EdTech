# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# Entorno: development | production | test
NODE_ENV=development

# Puerto del servidor HTTP
PORT=3000

# Conexión a MongoDB (obligatoria)
# Local:  mongodb://127.0.0.1:27017/edtech
# Atlas:  mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/edtech
MONGODB_URI=mongodb://127.0.0.1:27017/edtech

# Orígenes permitidos por CORS, separados por coma (frontend de Vite por defecto)
CORS_ORIGIN=http://localhost:5173

# ── Autenticación ────────────────────────────────────────────
# Secreto para firmar los JWT (obligatorio, mínimo 32 caracteres).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Duración de la sesión (formato de jsonwebtoken: 8h, 1d, 30m...)
JWT_EXPIRES_IN=8h

# Costo de bcrypt (entre 10 y 12 es razonable; más alto = más lento)
BCRYPT_SALT_ROUNDS=12

# ── Protección contra intentos repetidos ─────────────────────
# Intentos fallidos de login permitidos por IP + correo dentro de la ventana
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
# Registros permitidos por IP en una hora
REGISTER_MAX_PER_HOUR=10

# ── Seguimiento académico ────────────────────────────────────
# Porcentaje de logro bajo el cual un resultado se señala para acompañamiento (0-100).
# Es un indicador de apoyo al docente, no un diagnóstico.
PERFORMANCE_THRESHOLD=60

# ── Inteligencia artificial (guías de clase y reportes) ─────
# Proveedor: gemini (recomendado) | mock (sin llamadas externas, contenido de EJEMPLO)
#            | anthropic | openai-compatible
AI_PROVIDER=gemini
# Clave de Google AI Studio. NUNCA la subas al repositorio: va solo en tu .env (está en .gitignore).
AI_API_KEY=
# Con gemini estos tienen valor por defecto; descomenta solo si quieres cambiarlos:
AI_MODEL=gemini-3.8-flash
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_REASONING_EFFORT=low          # none | minimal | low | medium | high
# Límites (con gemini por defecto: 45000 ms y 4096 tokens de salida)
# AI_TIMEOUT_MS=45000
# AI_MAX_OUTPUT_TOKENS=4096
AI_TEMPERATURE=0.4
AI_MAX_INPUT_CHARS=12000
AI_MAX_OUTPUT_CHARS=20000
AI_MAX_ATTEMPTS=2
AI_DAILY_LIMIT_PER_TEACHER=20
AI_RATE_LIMIT_PER_MINUTE=5
# Solo para anthropic: versión de la API (cabecera anthropic-version)
# AI_ANTHROPIC_VERSION=2023-06-01
#
# Otras opciones gratuitas con AI_PROVIDER=openai-compatible:
#   Groq:   AI_BASE_URL=https://api.groq.com/openai/v1
#   Ollama: AI_BASE_URL=http://localhost:11434/v1  y  AI_API_KEY=ollama  (local)

# ── Seguimiento de estrategias ───────────────────────────────
# Clasificación pedagógica por defecto para nuevos seguimientos: vark | honey-alonso
# (cada seguimiento usa una sola; ver docs/clasificaciones-pedagogicas.md)
PEDAGOGICAL_CLASSIFICATION=vark
